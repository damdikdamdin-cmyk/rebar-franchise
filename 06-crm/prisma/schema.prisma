generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  founder
  uk_admin
  uk_sales
  uk_curator
  uk_marketer
  partner
  store_manager
  seller
}

enum StoreKind {
  owned
  franchise
}

enum StoreFormat {
  flagship
  standard
  pickup
}

enum StoreStatus {
  launch
  open
  closed
}

enum PartnerStatus {
  onboarding
  active
  paused
}

enum LeadStage {
  new
  contacted
  qualified
  zoom
  negotiation
  contract
  paid
  lost
}

enum LaunchStatus {
  active
  opened
  paused
}

enum TaskStatus {
  pending
  in_progress
  done
  skipped
}

enum ArticleStatus {
  draft
  published
  archived
}

enum ContentStatus {
  idea
  draft
  scheduled
  published
}

enum CampaignStatus {
  planned
  active
  finished
}

// ---------- Организация ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  partnerId    String?
  storeId      String?
  phone        String?
  onboardedAt  DateTime?
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())

  partner Partner? @relation("PartnerUsers", fields: [partnerId], references: [id], onDelete: SetNull)
  store   Store?   @relation("StoreStaff", fields: [storeId], references: [id], onDelete: SetNull)

  curatedPartners Partner[]        @relation("PartnerCurator")
  ownedLeads      Lead[]           @relation("LeadOwner")
  leadActivities  LeadActivity[]
  launchProjects  LaunchProject[]  @relation("LaunchCurator")
  invitesCreated  Invite[]         @relation("InviteAuthor")
  tasksAssigned   Task[]           @relation("TaskAssignee")
  tasksCreated    Task[]           @relation("TaskAuthor")
  articles        KbArticle[]      @relation("ArticleAuthor")
  enrollments     Enrollment[]
  notifications   Notification[]
  passwordResets  PasswordReset[]
  contentItems    ContentItem[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  token       String    @unique
  partnerId   String?
  storeId     String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  createdBy User?    @relation("InviteAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
}

model Partner {
  id            String        @id @default(cuid())
  name          String
  company       String?
  phone         String?
  email         String?
  city          String
  status        PartnerStatus @default(onboarding)
  format        StoreFormat   @default(standard)
  signedAt      DateTime?
  curatorUserId String?
  telegramChat  String?
  createdAt     DateTime      @default(now())

  curator        User?           @relation("PartnerCurator", fields: [curatorUserId], references: [id], onDelete: SetNull)
  users          User[]          @relation("PartnerUsers")
  stores         Store[]
  leads          Lead[]
  launchProjects LaunchProject[]
  invites        Invite[]
  tasks          Task[]
}

model Store {
  id        String      @id @default(cuid())
  name      String
  city      String
  kind      StoreKind
  format    StoreFormat
  status    StoreStatus @default(open)
  partnerId String?
  openedAt  DateTime?
  address   String?
  phone     String?
  createdAt DateTime    @default(now())

  partner        Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  staff          User[]          @relation("StoreStaff")
  launchProjects LaunchProject[]
  invites        Invite[]
  tasks          Task[]
}

// ---------- Воронка УК ----------

model Lead {
  id          String    @id @default(cuid())
  name        String
  phone       String
  email       String?
  city        String?
  note        String?
  source      String    @default("landing")
  stage       LeadStage @default(new)
  budget      Int?
  format      StoreFormat?
  ownerUserId String?
  partnerId   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  nextStepAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner      User?          @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  partner    Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  activities LeadActivity[]
  tasks      Task[]
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  body      String
  userId    String?
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------- Запуск ----------

model LaunchProject {
  id            String       @id @default(cuid())
  partnerId     String
  storeId       String       @unique
  curatorUserId String?
  startedAt     DateTime     @default(now())
  targetOpenAt  DateTime?
  status        LaunchStatus @default(active)

  partner Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  store   Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  curator User?        @relation("LaunchCurator", fields: [curatorUserId], references: [id], onDelete: SetNull)
  tasks   LaunchTask[]
}

model LaunchTask {
  id            String     @id @default(cuid())
  projectId     String
  code          String
  title         String
  phase         String
  ownerRole     String
  dueOffsetDays Int
  sortOrder     Int
  status        TaskStatus @default(pending)
  completedAt   DateTime?
  comment       String?
  articleSlug   String?

  project LaunchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
}

// ---------- Задачи и уведомления ----------

model Task {
  id           String     @id @default(cuid())
  title        String
  body         String?
  status       TaskStatus @default(pending)
  dueAt        DateTime?
  assigneeId   String?
  createdById  String?
  leadId       String?
  partnerId    String?
  storeId      String?
  createdAt    DateTime   @default(now())
  completedAt  DateTime?

  assignee  User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("TaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- База знаний ----------

model KbSpace {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int     @default(0)
  // роли через запятую: "founder,uk_admin,partner"
  visibleRoles String

  articles KbArticle[]
}

model KbArticle {
  id           String        @id @default(cuid())
  spaceId      String
  slug         String        @unique
  title        String
  summary      String?
  body         String
  status       ArticleStatus @default(published)
  version      Int           @default(1)
  // роли через запятую; пусто = как у пространства
  visibleRoles String?
  tags         String?
  sourcePath   String?
  sortOrder    Int           @default(0)
  authorId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  space       KbSpace        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author      User?          @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lessons     Lesson[]
  attachments KbAttachment[]
}

model KbAttachment {
  id        String @id @default(cuid())
  articleId String
  name      String
  path      String
  mime      String

  article KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// ---------- Обучение ----------

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  // роли, которым курс назначается автоматически
  autoRoles   String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id        String  @id @default(cuid())
  courseId  String
  articleId String?
  title     String
  // чек-лист: пункты через "\n"
  checklist String?
  sortOrder Int     @default(0)

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  article  KbArticle?       @relation(fields: [articleId], references: [id], onDelete: SetNull)
  progress LessonProgress[]
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  // индексы отмеченных пунктов чек-листа через запятую
  checked      String?
  completedAt  DateTime?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

// ---------- Маркетинг ----------

model Campaign {
  id        String         @id @default(cuid())
  name      String
  goal      String?
  channel   String?
  budget    Int?
  startsAt  DateTime?
  endsAt    DateTime?
  status    CampaignStatus @default(planned)
  createdAt DateTime       @default(now())

  contentItems ContentItem[]
  utmLinks     UtmLink[]
}

model ContentItem {
  id          String        @id @default(cuid())
  title       String
  channel     String
  rubric      String?
  body        String?
  publishAt   DateTime
  status      ContentStatus @default(idea)
  campaignId  String?
  authorId    String?
  createdAt   DateTime      @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  author   User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model UtmLink {
  id         String   @id @default(cuid())
  name       String
  baseUrl    String
  source     String
  medium     String
  campaign   String
  content    String?
  campaignId String?
  createdAt  DateTime @default(now())

  campaignRef Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}
