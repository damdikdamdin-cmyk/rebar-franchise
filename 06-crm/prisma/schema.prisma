generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  founder
  uk_admin
  uk_sales
  uk_curator
  uk_marketer
  partner
  store_manager
  seller
}

enum StoreKind {
  owned
  franchise
}

enum StoreFormat {
  flagship
  standard
  pickup
}

enum StoreStatus {
  launch
  open
  closed
}

enum PartnerStatus {
  onboarding
  active
  paused
}

enum LeadStage {
  new
  contacted
  qualified
  zoom
  negotiation
  contract
  paid
  lost
}

enum LaunchStatus {
  active
  opened
  paused
}

enum TaskStatus {
  pending
  in_progress
  done
  skipped
}

enum ArticleStatus {
  draft
  published
  archived
}

enum ContentStatus {
  idea
  draft
  scheduled
  published
}

enum CampaignStatus {
  planned
  active
  finished
}

enum StockDocType {
  receipt
  transfer
  customer_return
  supplier_return
  inventory
  writeoff
}

enum DiscountType {
  none
  amount
  percent
}

enum OrderKind {
  stock_reserve
  procurement
}

enum OrderStatus {
  draft
  reserved
  issued
  cancelled
  accepted
  purchased
  in_transit
  arrived
}

enum CashTxnDirection {
  in
  out
}

enum SerialStatus {
  in_stock
  reserved
  sold
  written_off
}

// ---------- Организация ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role
  partnerId     String?
  storeId       String?
  phone         String?
  commissionPct Float     @default(0)
  /// Оклад за смену, ₽
  shiftPay      Int       @default(0)
  /// Шаблон прав точки (галочки LiveSklad-style)
  accessRoleId  String?
  onboardedAt   DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())

  partner    Partner?    @relation("PartnerUsers", fields: [partnerId], references: [id], onDelete: SetNull)
  store      Store?      @relation("StoreStaff", fields: [storeId], references: [id], onDelete: SetNull)
  accessRole AccessRole? @relation(fields: [accessRoleId], references: [id], onDelete: SetNull)

  curatedPartners Partner[]        @relation("PartnerCurator")
  ownedLeads      Lead[]           @relation("LeadOwner")
  leadActivities  LeadActivity[]
  launchProjects  LaunchProject[]  @relation("LaunchCurator")
  invitesCreated  Invite[]         @relation("InviteAuthor")
  tasksAssigned   Task[]           @relation("TaskAssignee")
  tasksCreated    Task[]           @relation("TaskAuthor")
  articles        KbArticle[]      @relation("ArticleAuthor")
  enrollments     Enrollment[]
  notifications   Notification[]
  passwordResets  PasswordReset[]
  contentItems    ContentItem[]
  sales           Sale[]
  salesDeleted    Sale[]           @relation("SaleDeletedBy")
  stockDocuments  StockDocument[]
  stockDocsDeleted StockDocument[] @relation("StockDocDeletedBy")
  cashTxns        CashTxn[]
  orders          Order[]
  printTemplates  PrintTemplate[]
  changeLogs      ChangeLog[]
  workShifts      WorkShift[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invite {
  id           String    @id @default(cuid())
  email        String
  /// Имя до регистрации (показывается в документах после join)
  nameHint     String?
  role         Role
  accessRoleId String?
  token        String    @unique
  partnerId    String?
  storeId      String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  createdById  String?

  createdBy  User?       @relation("InviteAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  accessRole AccessRole? @relation(fields: [accessRoleId], references: [id], onDelete: SetNull)
  partner    Partner?    @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  store      Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
}

/// Шаблон прав точки (галочки как в LiveSklad). system=true — пресет сети.
model AccessRole {
  id          String   @id @default(cuid())
  name        String
  storeId     String?
  homePage    String   @default("/pos")
  /// JSON: Record<PermissionKey, boolean>
  permissions String   @default("{}")
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store   Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  users   User[]
  invites Invite[]

  @@index([storeId])
}

model Partner {
  id            String        @id @default(cuid())
  name          String
  company       String?
  phone         String?
  email         String?
  city          String
  status        PartnerStatus @default(onboarding)
  format        StoreFormat   @default(standard)
  signedAt      DateTime?
  curatorUserId String?
  telegramChat  String?
  createdAt     DateTime      @default(now())

  curator        User?           @relation("PartnerCurator", fields: [curatorUserId], references: [id], onDelete: SetNull)
  users          User[]          @relation("PartnerUsers")
  stores         Store[]
  leads          Lead[]
  launchProjects LaunchProject[]
  invites        Invite[]
  tasks          Task[]
}

model Store {
  id           String      @id @default(cuid())
  name         String
  city         String
  kind         StoreKind
  format       StoreFormat
  status       StoreStatus @default(open)
  partnerId    String?
  openedAt     DateTime?
  address      String?
  phone        String?
  /// Реквизиты юрлица точки для печатных форм (пусто → из COMPANY_* в .env)
  legalName    String?
  inn          String?
  ogrn         String?
  legalAddress String?
  createdAt    DateTime    @default(now())

  partner        Partner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  staff          User[]           @relation("StoreStaff")
  launchProjects LaunchProject[]
  invites        Invite[]
  tasks          Task[]
  customers      Customer[]
  sales          Sale[]
  balances       StockBalance[]
  serials        ProductSerial[]
  stockDocs      StockDocument[]  @relation("DocStore")
  stockDocsTo    StockDocument[]  @relation("DocToStore")
  cashRegisters  CashRegister[]
  orders         Order[]
  changeLogs     ChangeLog[]
  workShifts     WorkShift[]
  accessRoles    AccessRole[]
}

// ---------- Воронка УК ----------

model Lead {
  id          String    @id @default(cuid())
  name        String
  phone       String
  email       String?
  city        String?
  note        String?
  source      String    @default("landing")
  stage       LeadStage @default(new)
  budget      Int?
  format      StoreFormat?
  ownerUserId String?
  partnerId   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  nextStepAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner      User?          @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  partner    Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  activities LeadActivity[]
  tasks      Task[]
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  body      String
  userId    String?
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------- Запуск ----------

model LaunchProject {
  id            String       @id @default(cuid())
  partnerId     String
  storeId       String       @unique
  curatorUserId String?
  startedAt     DateTime     @default(now())
  targetOpenAt  DateTime?
  status        LaunchStatus @default(active)

  partner Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  store   Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  curator User?        @relation("LaunchCurator", fields: [curatorUserId], references: [id], onDelete: SetNull)
  tasks   LaunchTask[]
}

model LaunchTask {
  id            String     @id @default(cuid())
  projectId     String
  code          String
  title         String
  phase         String
  ownerRole     String
  dueOffsetDays Int
  sortOrder     Int
  status        TaskStatus @default(pending)
  completedAt   DateTime?
  comment       String?
  articleSlug   String?

  project LaunchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
}

// ---------- Задачи и уведомления ----------

model Task {
  id           String     @id @default(cuid())
  title        String
  body         String?
  status       TaskStatus @default(pending)
  dueAt        DateTime?
  assigneeId   String?
  createdById  String?
  leadId       String?
  partnerId    String?
  storeId      String?
  createdAt    DateTime   @default(now())
  completedAt  DateTime?

  assignee  User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("TaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- База знаний ----------

model KbSpace {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int     @default(0)
  // роли через запятую: "founder,uk_admin,partner"
  visibleRoles String

  articles KbArticle[]
}

model KbArticle {
  id           String        @id @default(cuid())
  spaceId      String
  slug         String        @unique
  title        String
  summary      String?
  body         String
  status       ArticleStatus @default(published)
  version      Int           @default(1)
  // роли через запятую; пусто = как у пространства
  visibleRoles String?
  tags         String?
  sourcePath   String?
  sortOrder    Int           @default(0)
  authorId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  space       KbSpace        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author      User?          @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lessons     Lesson[]
  attachments KbAttachment[]
}

model KbAttachment {
  id        String @id @default(cuid())
  articleId String
  name      String
  path      String
  mime      String

  article KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// ---------- Обучение ----------

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  // роли, которым курс назначается автоматически
  autoRoles   String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id        String  @id @default(cuid())
  courseId  String
  articleId String?
  title     String
  // чек-лист: пункты через "\n"
  checklist String?
  sortOrder Int     @default(0)

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  article  KbArticle?       @relation(fields: [articleId], references: [id], onDelete: SetNull)
  progress LessonProgress[]
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  // индексы отмеченных пунктов чек-листа через запятую
  checked      String?
  completedAt  DateTime?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

// ---------- Маркетинг ----------

model Campaign {
  id        String         @id @default(cuid())
  name      String
  goal      String?
  channel   String?
  budget    Int?
  startsAt  DateTime?
  endsAt    DateTime?
  status    CampaignStatus @default(planned)
  createdAt DateTime       @default(now())

  contentItems ContentItem[]
  utmLinks     UtmLink[]
}

model ContentItem {
  id          String        @id @default(cuid())
  title       String
  channel     String
  rubric      String?
  body        String?
  publishAt   DateTime
  status      ContentStatus @default(idea)
  campaignId  String?
  authorId    String?
  createdAt   DateTime      @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  author   User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model UtmLink {
  id         String   @id @default(cuid())
  name       String
  baseUrl    String
  source     String
  medium     String
  campaign   String
  content    String?
  campaignId String?
  createdAt  DateTime @default(now())

  campaignRef Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

// ---------- Розница (из Hub) ----------

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  phone     String
  notes     String?
  createdAt DateTime @default(now())

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales  Sale[]
  orders Order[]

  @@unique([storeId, phone])
}

model Sale {
  id            String    @id @default(cuid())
  storeId       String
  customerId    String?
  sellerUserId  String?
  amount        Int
  creditAmount  Int       @default(0)
  /// Оплата картой (остальное — наличные, минус Lendo)
  cardAmount    Int       @default(0)
  discountTotal Int       @default(0)
  note          String?
  number        String?
  soldAt        DateTime  @default(now())
  createdAt     DateTime  @default(now())
  /// Мягкое удаление: чек скрыт из списков, но доступен в истории
  deletedAt     DateTime?
  deletedById   String?
  deletedReason String?

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  seller    User?      @relation(fields: [sellerUserId], references: [id], onDelete: SetNull)
  deletedBy User?      @relation("SaleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  lines     SaleLine[]
  cashTxns  CashTxn[]

  @@index([storeId, deletedAt])
  @@index([storeId, soldAt])
}

model SaleLine {
  id            String       @id @default(cuid())
  saleId        String
  productId     String?
  name          String
  qty           Int          @default(1)
  unitPrice     Int
  costPrice     Int          @default(0)
  discountType  DiscountType @default(none)
  discountValue Int          @default(0)
  lineTotal     Int
  serial        String?
  note          String?
  warrantyDays  Int?
  /// Мягкое удаление позиции в чеке
  deletedAt     DateTime?
  deletedById   String?

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model ProductGroup {
  id        String  @id @default(cuid())
  name      String
  parentId  String?
  sortOrder Int     @default(0)

  parent   ProductGroup?  @relation("GroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductGroup[] @relation("GroupTree")
  products Product[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  note      String?
  createdAt DateTime @default(now())

  products Product[]
  docs     StockDocument[]
}

model Product {
  id            String   @id @default(cuid())
  code          String   @unique
  barcode       String?
  sku           String?
  name          String
  groupId       String?
  unit          String   @default("шт")
  warrantyDays  Int      @default(365)
  serialTracked Boolean  @default(false)
  purchasePrice Int      @default(0)
  retailPrice   Int      @default(0)
  repairPrice   Int      @default(0)
  preorderPrice Int      @default(0)
  minStock      Int      @default(0)
  commissionPct Int      @default(0)
  commissionRub Int      @default(0)
  description   String?
  supplierId    String?
  active        Boolean  @default(true)
  /// Мягкое удаление номенклатуры — скрыта с остатков, видна в истории
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime @default(now())

  group      ProductGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  supplier   Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  balances   StockBalance[]
  serials    ProductSerial[]
  lines      StockLine[]
  saleLines  SaleLine[]
  orderLines OrderLine[]

  @@index([barcode])
  @@index([deletedAt])
}

model ProductSerial {
  id            String       @id @default(cuid())
  productId     String
  storeId       String
  serial        String
  status        SerialStatus @default(in_stock)
  purchasePrice Int?
  retailPrice   Int?
  warrantyDays  Int?
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, serial])
  @@index([serial])
}

model StockBalance {
  id        String @id @default(cuid())
  storeId   String
  productId String
  qty       Int    @default(0)

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
}

model StockDocument {
  id             String       @id @default(cuid())
  number         String
  type           StockDocType
  storeId        String
  toStoreId      String?
  supplierId     String?
  customerId     String?
  userId         String?
  comment        String?
  externalNumber String?
  externalDate   DateTime?
  totalAmount    Int          @default(0)
  paidAmount     Int          @default(0)
  postedAt       DateTime?
  /// Мягкое удаление: документ скрыт из списков, остаётся в истории
  deletedAt      DateTime?
  deletedById    String?
  deletedReason  String?
  createdAt      DateTime     @default(now())

  store     Store       @relation("DocStore", fields: [storeId], references: [id], onDelete: Cascade)
  toStore   Store?      @relation("DocToStore", fields: [toStoreId], references: [id], onDelete: SetNull)
  supplier  Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  deletedBy User?       @relation("StockDocDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  lines     StockLine[]
  cashTxns  CashTxn[]

  @@index([storeId, type, postedAt])
  @@index([storeId, deletedAt])
}

model StockLine {
  id           String  @id @default(cuid())
  documentId   String
  productId    String
  qty          Int
  qtyAccount   Int     @default(0)
  qtyActual    Int     @default(0)
  price        Int     @default(0)
  retailPrice  Int     @default(0)
  warrantyDays Int?
  serial       String?
  note         String?

  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model CashRegister {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  balance   Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  store Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  txns  CashTxn[]
}

model CashCategory {
  id        String           @id @default(cuid())
  name      String
  direction CashTxnDirection
  system    Boolean          @default(false)

  txns CashTxn[]
}

model CashTxn {
  id           String           @id @default(cuid())
  registerId   String
  categoryId   String?
  direction    CashTxnDirection
  amount       Int
  balanceAfter Int
  saleId       String?
  stockDocId   String?
  userId       String?
  recipient    String?
  note         String?
  occurredAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())

  register CashRegister  @relation(fields: [registerId], references: [id], onDelete: Cascade)
  category CashCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sale     Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  stockDoc StockDocument? @relation(fields: [stockDocId], references: [id], onDelete: SetNull)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Order {
  id            String      @id @default(cuid())
  number        String
  storeId       String
  customerId    String?
  userId        String?
  kind          OrderKind   @default(stock_reserve)
  status        OrderStatus @default(draft)
  totalAmount   Int         @default(0)
  prepaidAmount Int         @default(0)
  comment       String?
  dueAt         DateTime?
  createdAt     DateTime    @default(now())
  issuedAt      DateTime?

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines    OrderLine[]
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  qty       Int     @default(1)
  unitPrice Int
  lineTotal Int
  serial    String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

/// Смена в графике работы точки.
model WorkShift {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  /// Дата смены (день, локально YYYY-MM-DD в 12:00)
  date      DateTime
  startTime String    @default("10:00")
  endTime   String    @default("20:00")
  /// Оклад за эту смену; если null — берётся User.shiftPay
  shiftPay  Int?
  note      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId, date])
  @@index([storeId, date])
  @@index([storeId, deletedAt])
}

/// Печатная форма: HTML-шаблон с переменными <Имя>.
model PrintTemplate {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  scope        String
  html         String
  pageWidthMm  Int      @default(210)
  pageHeightMm Int      @default(297)
  marginMm     Int      @default(10)
  fontSizePt   Int      @default(11)
  sortOrder    Int      @default(0)
  isSystem     Boolean  @default(false)
  active       Boolean  @default(true)
  sourceFile   String?
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Журнал изменений: номенклатура, IMEI, цены, гарантия, продажи, чеки.
/// Старый IMEI ищется по serialOld — историю нельзя «стереть» сменой номера.
model ChangeLog {
  id           String   @id @default(cuid())
  storeId      String?
  userId       String?
  entityType   String
  entityId     String
  action       String
  summary      String
  field        String?
  oldValue     String?
  newValue     String?
  productId    String?
  serialId     String?
  serialOld    String?
  serialNew    String?
  saleId       String?
  stockDocId   String?
  meta         String?
  createdAt    DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([productId])
  @@index([serialId])
  @@index([serialOld])
  @@index([serialNew])
  @@index([saleId])
  @@index([storeId, createdAt])
}
