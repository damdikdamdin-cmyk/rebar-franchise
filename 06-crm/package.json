{
  "name": "06-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "prisma generate && next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:seed:retail": "node ./node_modules/tsx/dist/cli.mjs prisma/seed-retail.ts",
    "kb:import": "node ./node_modules/tsx/dist/cli.mjs scripts/import-kb.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed && npm run kb:import",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
